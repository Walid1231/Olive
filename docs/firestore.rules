rules_version = '2';
// Olive — Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Profiles: any signed-in user can read (needed for friend search by name / email / code).
    // You can edit your own profile. Others may only add/remove THEMSELVES in your friend list
    // (that's what accepting / removing a friend does).
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        request.auth.uid == uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendIds', 'friendCount']) &&
          // someone else may only add or remove THEMSELVES
          request.resource.data.get('friendIds', []).toSet()
            .difference(resource.data.get('friendIds', []).toSet()).hasOnly([request.auth.uid]) &&
          resource.data.get('friendIds', []).toSet()
            .difference(request.resource.data.get('friendIds', []).toSet()).hasOnly([request.auth.uid])
        )
      );
      allow delete: if signedIn() && request.auth.uid == uid;

      // Inbox: friend requests + shared songs / audiobooks / playlists.
      // Anyone signed in can drop a notification in; only the owner reads / marks / deletes.
      match /inbox/{notifId} {
        allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
        allow read, update, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Friend requests between two people
    match /friendRequests/{reqId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if signedIn() && request.auth.uid in [resource.data.fromUid, resource.data.toUid];
      allow delete: if signedIn() && request.auth.uid == resource.data.fromUid;
    }

    // Listen Together sessions (doc id = host uid). The host writes everything;
    // invited friends may only add / remove themselves in members + memberNames.
    match /sessions/{hostUid} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == hostUid;
      allow update: if signedIn() && (
        request.auth.uid == hostUid ||
        (
          request.auth.uid in resource.data.invited &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
        )
      );
    }

    // Group playlists: every member can read and edit; only the owner deletes.
    match /collabPlaylists/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Shared playlists: readable by any signed-in user who has the link, written by the owner
    match /sharedPlaylists/{shareId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
