<?xml version="1.0" encoding="utf-8"?>
<!-- Olive home-screen widget: cover, title/artist, previous · play/pause · next -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:contentDescription="@string/widget_art"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_art_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/widget_label_idle"
            android:textAllCaps="true"
            android:textColor="#2E9C73"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_title_idle"
            android:textColor="#1C2333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_artist_idle"
            android:textColor="#5B6478"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="@string/widget_prev"
                android:padding="8dp"
                android:src="@drawable/ic_w_prev" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/widget_play_bg"
                android:contentDescription="@string/widget_play"
                android:padding="11dp"
                android:src="@drawable/ic_w_play" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="@string/widget_next"
                android:padding="8dp"
                android:src="@drawable/ic_w_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
